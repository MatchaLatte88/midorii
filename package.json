{
  "name": "midorii",
  "version": "0.7.1",
  "description": "Midorii — local backtesting and trading-bot workbench, built on a Vela fork.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "app/electron/main.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers/binance": {
      "types": "./dist/providers/binance.d.ts",
      "import": "./dist/providers/binance.js",
      "require": "./dist/providers/binance.cjs"
    },
    "./providers/hyperliquid": {
      "types": "./dist/providers/hyperliquid.d.ts",
      "import": "./dist/providers/hyperliquid.js",
      "require": "./dist/providers/hyperliquid.cjs"
    },
    "./providers/coinbase": {
      "types": "./dist/providers/coinbase.d.ts",
      "import": "./dist/providers/coinbase.js",
      "require": "./dist/providers/coinbase.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "playground": "vite --config playground/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "dev": "vite",
    "app": "concurrently -k -n VITE,ELECTRON -c cyan,green \"npm run dev\" \"wait-on tcp:5301 && electron .\"",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@mathieuc/tradingview": "^3.5.2",
    "@zag-js/core": "^1.42.0",
    "@zag-js/dialog": "^1.42.0",
    "@zag-js/dom-query": "^1.42.0",
    "@zag-js/menu": "^1.42.0",
    "@zag-js/tooltip": "^1.42.0",
    "@zag-js/types": "^1.42.0",
    "@zag-js/vanilla": "^1.42.0",
    "fflate": "^0.8.2"
  }
}
