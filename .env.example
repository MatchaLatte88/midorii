# Copy this file to .env.local and fill in real values there — .env.local is
# git-ignored, this file is not, so never put a real secret in .env.example.

# Capital.com (forex/CFD data) — Settings -> API Integrations on the Capital.com
# platform to create an API key. `identifier`/`password` are your normal Capital.com
# login (password is your account password, not the API key).
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
# demo (default, recommended) or live — a demo account sees the same real market
# prices; only the money is fake. Use live only if you deliberately want this data
# connection tied to your real trading account's credentials.
CAPITAL_ENV=demo
