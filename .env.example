# Copy this file to .env.local and fill in real values there — .env.local is
# git-ignored, this file is not, so never put a real secret in .env.example.

# Capital.com (forex/CFD data, and live trading) — Settings → API integrations on the
# Capital.com platform to create an API key. Two-factor authentication has to be on
# before the platform will issue one.
#
# CAPITAL_IDENTIFIER is the email you log in with.
#
# CAPITAL_PASSWORD is NOT your account login password. When you generate the API key the
# platform asks for a "Custom password" — that one, set for this key alone. It is what
# POST /session authenticates with, it can do only what the API can do, and revoking the
# key revokes it. Your account password does not work here and should not be put here.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# demo (default, recommended) or live.
#
# A demo account sees the same real market prices; only the money is fake. This is also
# the switch that decides whether the chart's Trade menu offers a real account: on `live`
# an order placed from the chart is a real order that cannot be undone, and the app says
# so — a red band on the chart, and a confirmation that has to be typed out.
CAPITAL_ENV=demo
